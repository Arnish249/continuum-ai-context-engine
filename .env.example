# Continuum - Environment Configuration

# Required: Google AI Studio API key with access to Gemma 4 models
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Gemma 4 Model Identifier (Must be a genuine Gemma 4 model)
# Options:
#   gemma-4-31b-it (Recommended: 31B dense instruction-tuned model)
#   gemma-4-26b-a4b-it (26B mixture-of-experts model)
#   gemma-4-e4b-it (Edge/efficient 4B model)
GEMMA_MODEL=gemma-4-31b-it

# API Base URL
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Server Configuration
PORT=3000

# Optional: Local Ollama endpoint if running Gemma 4 locally
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:31b
